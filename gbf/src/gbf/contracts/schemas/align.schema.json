{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gbf:schema:align",
  "title": "Alignment receipt (align.json)",
  "description": "Receipt of kind 'align' written by `python -m gbf align` (gbf.events.align). It aligns StatsBomb event timestamps (period-relative) to SoccerNet half videos (Labels-v2 positions, milliseconds from the first frame of each half video) with one constant offset per half, estimated from shot labels, and lists every shot pair with its residual and status. The envelope follows urn:gbf:schema:receipt; this schema fixes kind, producer, inputs, restrictions and the result payload. Status: 'passed' when both halves are aligned, both kick-off checks are ok and every input matches a pin; 'failed' when no half is aligned or a stated expectation is not met; 'partial' otherwise. Times are seconds unless a key ends in _ms. The file carries no_share, non_commercial and statsbomb_logo and is never committed. $defs/fetch_record is the sidecar `python -m gbf fetch` writes next to each verified download.",
  "$ref": "urn:gbf:schema:receipt",
  "type": "object",
  "required": ["environment", "reviewer_type"],
  "properties": {
    "kind": {"const": "align"},
    "producer": {"const": "gbf.events.align"},
    "inputs": {
      "description": "Exactly the three inputs, in this order. source_revision is the pinned revision, or 'unpinned' when the bytes match no pin in pins.toml.",
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/input", "properties": {"name": {"const": "statsbomb_events"}}},
        {"$ref": "#/$defs/input", "properties": {"name": {"const": "statsbomb_lineups"}}},
        {"$ref": "#/$defs/input", "properties": {"name": {"const": "soccernet_labels_v2"}}}
      ],
      "minItems": 3,
      "items": false
    },
    "restrictions": {
      "description": "Union of the inputs' restrictions; StatsBomb inputs always bring these three.",
      "allOf": [
        {"contains": {"const": "no_share"}},
        {"contains": {"const": "non_commercial"}},
        {"contains": {"const": "statsbomb_logo"}}
      ]
    },
    "reviewer_type": {"const": "automated"},
    "environment": {
      "type": "object",
      "required": ["python", "kloppy"]
    },
    "result": {"$ref": "#/$defs/result"}
  },
  "$defs": {
    "half": {"enum": [1, 2]},
    "nullable_number": {"type": ["number", "null"]},
    "statsbomb_timestamp": {
      "description": "Raw StatsBomb timestamp, HH:MM:SS.fff, restarting at 0 in every period.",
      "type": "string",
      "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9][.][0-9]{3}$"
    },
    "game_time": {
      "description": "SoccerNet gameTime, '<half> - MM:SS'.",
      "type": "string",
      "pattern": "^[12] - [0-9]{1,3}:[0-5][0-9]$"
    },
    "input": {
      "type": "object",
      "required": ["name", "sha256", "git_blob_sha1", "source_revision", "bytes"],
      "properties": {
        "source_revision": {
          "anyOf": [{"$ref": "urn:gbf:schema:common#/$defs/git_sha1"}, {"const": "unpinned"}]
        }
      }
    },
    "label_ref": {
      "type": "object",
      "required": ["half", "label", "label_index", "label_game_time", "label_position_ms"],
      "properties": {
        "half": {"$ref": "#/$defs/half"},
        "label": {"enum": ["Shots on target", "Shots off target"]},
        "label_index": {
          "description": "Index of the annotation in the Labels-v2 annotations array.",
          "$ref": "urn:gbf:schema:common#/$defs/nonneg_int"
        },
        "label_game_time": {"$ref": "#/$defs/game_time"},
        "label_position_ms": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"}
      }
    },
    "shot_ref": {
      "type": "object",
      "required": [
        "statsbomb_event_id",
        "statsbomb_period",
        "statsbomb_timestamp",
        "statsbomb_timestamp_s",
        "statsbomb_team"
      ],
      "properties": {
        "statsbomb_event_id": {"type": "string", "minLength": 1},
        "statsbomb_period": {"$ref": "#/$defs/half"},
        "statsbomb_timestamp": {"$ref": "#/$defs/statsbomb_timestamp"},
        "statsbomb_timestamp_s": {"type": "number", "minimum": 0},
        "statsbomb_team": {"type": "string", "minLength": 1}
      }
    },
    "unmatched_label": {
      "$ref": "#/$defs/label_ref",
      "unevaluatedProperties": false
    },
    "unmatched_shot": {
      "$ref": "#/$defs/shot_ref",
      "unevaluatedProperties": false
    },
    "pair": {
      "description": "One shot label and its nearest StatsBomb Shot of the same period.",
      "type": "object",
      "allOf": [{"$ref": "#/$defs/label_ref"}, {"$ref": "#/$defs/shot_ref"}],
      "required": [
        "video_position_s",
        "label_team",
        "label_visibility",
        "statsbomb_team_side",
        "statsbomb_shot_outcome",
        "diff_s",
        "residual_s",
        "status",
        "team_match",
        "shared_match"
      ],
      "properties": {
        "video_position_s": {"type": "number", "minimum": 0},
        "label_team": {"type": ["string", "null"]},
        "label_visibility": {"type": ["string", "null"]},
        "statsbomb_team_side": {"enum": ["home", "away"]},
        "statsbomb_shot_outcome": {"type": ["string", "null"]},
        "diff_s": {"description": "statsbomb_timestamp_s - video_position_s.", "type": "number"},
        "residual_s": {"description": "diff_s - offset_s of the half.", "type": "number"},
        "status": {"enum": ["ok", "needs_review"]},
        "team_match": {
          "description": "Whether the label's home/away team is the shot's team; null when the label names no side. Informational: matching ignores teams.",
          "type": ["boolean", "null"]
        },
        "shared_match": {
          "description": "True when this StatsBomb shot is also the nearest shot of another label.",
          "type": "boolean"
        }
      },
      "unevaluatedProperties": false
    },
    "half_offset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "half",
        "statsbomb_period",
        "aligned",
        "offset_s",
        "n_pairs",
        "n_ok",
        "n_needs_review",
        "n_unmatched_labels",
        "max_abs_residual_s"
      ],
      "properties": {
        "half": {"$ref": "#/$defs/half"},
        "statsbomb_period": {"$ref": "#/$defs/half"},
        "aligned": {"type": "boolean"},
        "offset_s": {"$ref": "#/$defs/nullable_number"},
        "n_pairs": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"},
        "n_ok": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"},
        "n_needs_review": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"},
        "n_unmatched_labels": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"},
        "max_abs_residual_s": {"type": ["number", "null"], "minimum": 0}
      },
      "if": {"properties": {"aligned": {"const": true}}, "required": ["aligned"]},
      "then": {
        "properties": {
          "offset_s": {"type": "number"},
          "n_pairs": {"minimum": 1},
          "max_abs_residual_s": {"type": "number"}
        }
      },
      "else": {
        "properties": {
          "offset_s": {"const": null},
          "n_pairs": {"const": 0},
          "max_abs_residual_s": {"const": null}
        }
      }
    },
    "kickoff_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "half",
        "status",
        "missing",
        "label_index",
        "label_position_ms",
        "statsbomb_event_id",
        "statsbomb_timestamp",
        "statsbomb_timestamp_s",
        "predicted_video_position_s",
        "deviation_s",
        "tolerance_s"
      ],
      "properties": {
        "half": {"$ref": "#/$defs/half"},
        "status": {"enum": ["ok", "needs_review", "missing"]},
        "missing": {
          "type": "array",
          "items": {"enum": ["label", "statsbomb_kickoff", "offset"]},
          "uniqueItems": true
        },
        "label_index": {"type": ["integer", "null"], "minimum": 0},
        "label_position_ms": {"type": ["integer", "null"], "minimum": 0},
        "statsbomb_event_id": {"type": ["string", "null"]},
        "statsbomb_timestamp": {
          "anyOf": [{"$ref": "#/$defs/statsbomb_timestamp"}, {"type": "null"}]
        },
        "statsbomb_timestamp_s": {"$ref": "#/$defs/nullable_number"},
        "predicted_video_position_s": {"$ref": "#/$defs/nullable_number"},
        "deviation_s": {"$ref": "#/$defs/nullable_number"},
        "tolerance_s": {"type": "number", "exclusiveMinimum": 0}
      },
      "if": {"properties": {"status": {"const": "missing"}}, "required": ["status"]},
      "then": {"properties": {"missing": {"minItems": 1}}},
      "else": {"properties": {"missing": {"maxItems": 0}, "deviation_s": {"type": "number"}}}
    },
    "source": {
      "description": "Which pin an input matched (by git blob id and role); all null when unpinned.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pin", "host", "repository", "revision", "path"],
      "properties": {
        "name": {"enum": ["statsbomb_events", "statsbomb_lineups", "soccernet_labels_v2"]},
        "pin": {"type": ["string", "null"]},
        "host": {"enum": ["github", "hf-dataset", null]},
        "repository": {"type": ["string", "null"]},
        "revision": {
          "anyOf": [{"$ref": "urn:gbf:schema:common#/$defs/git_sha1"}, {"type": "null"}]
        },
        "path": {"type": ["string", "null"]}
      }
    },
    "expectations": {
      "description": "Optional reproduction targets given on the command line. They never change the method; failing them makes the receipt 'failed'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "offsets", "min_ok"],
      "properties": {
        "ok": {"type": "boolean"},
        "offsets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["half", "expected_s", "actual_s", "tolerance_s", "ok"],
            "properties": {
              "half": {"$ref": "#/$defs/half"},
              "expected_s": {"type": "number"},
              "actual_s": {"$ref": "#/$defs/nullable_number"},
              "tolerance_s": {"type": "number", "exclusiveMinimum": 0},
              "ok": {"type": "boolean"}
            }
          }
        },
        "min_ok": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["expected", "actual", "ok"],
              "properties": {
                "expected": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"},
                "actual": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"},
                "ok": {"type": "boolean"}
              }
            }
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "offset_convention",
        "frame_convention",
        "kickoff_rule",
        "tolerance_s",
        "kickoff_tolerance_s",
        "halves",
        "pairs",
        "unmatched_labels",
        "unmatched_statsbomb_shots",
        "excluded_label_counts",
        "kickoff_checks",
        "sources",
        "statsbomb_loader",
        "summary",
        "warnings"
      ],
      "properties": {
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "shot_labels",
            "excluded_labels",
            "statsbomb_event_type",
            "matching",
            "offset",
            "status_rule"
          ],
          "properties": {
            "name": {"const": "nearest-shot-median-v1"},
            "shot_labels": {"const": ["Shots on target", "Shots off target"]},
            "excluded_labels": {"const": ["Goal"]},
            "statsbomb_event_type": {"const": "Shot"},
            "matching": {
              "const": "For each shot label, the StatsBomb Shot in the same period (label half h = StatsBomb period h) with the smallest |statsbomb_timestamp_s - video_position_s|; ties go to the earlier timestamp, then the smaller event id. Matching is not one-to-one."
            },
            "offset": {
              "const": "offset_s is the median of diff_s over the half's pairs (the mean of the two middle values for an even count)."
            },
            "status_rule": {
              "const": "residual_s = diff_s - offset_s; status is needs_review if |residual_s| > tolerance_s, else ok."
            }
          }
        },
        "offset_convention": {
          "const": "diff_s = statsbomb_timestamp_s - video_position_s, where statsbomb_timestamp_s is the StatsBomb timestamp (restarts at 0 in every period) and video_position_s is the Labels-v2 position / 1000 (milliseconds from the first frame of the half video). A positive offset means the StatsBomb clock reads later than the video for the same moment: video_position_s = statsbomb_timestamp_s - offset_s."
        },
        "frame_convention": {
          "const": "Canonical frame = (sha256 of the half's source video, CFR frame index within the half). Frame n spans [n/fps, (n+1)/fps) of video time, 0 being the first frame of the half video: frame = floor((statsbomb_timestamp_s - offset_s) * fps)."
        },
        "kickoff_rule": {
          "const": "Per half: earliest Labels-v2 'Kick-off' label and earliest StatsBomb kick-off pass; deviation_s = (statsbomb_timestamp_s - offset_s) - video_position_s; ok if |deviation_s| <= kickoff_tolerance_s. A coarse sanity bound (wrong half, wrong cut, gross clock error), not an accuracy measure: the half video may start just after the kick-off."
        },
        "tolerance_s": {"type": "number", "exclusiveMinimum": 0},
        "kickoff_tolerance_s": {"type": "number", "exclusiveMinimum": 0},
        "halves": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/half_offset", "properties": {"half": {"const": 1}}},
            {"$ref": "#/$defs/half_offset", "properties": {"half": {"const": 2}}}
          ],
          "minItems": 2,
          "items": false
        },
        "pairs": {"type": "array", "items": {"$ref": "#/$defs/pair"}},
        "unmatched_labels": {"type": "array", "items": {"$ref": "#/$defs/unmatched_label"}},
        "unmatched_statsbomb_shots": {
          "type": "array",
          "items": {"$ref": "#/$defs/unmatched_shot"}
        },
        "excluded_label_counts": {
          "type": "object",
          "propertyNames": {"enum": ["Goal"]},
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "kickoff_checks": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/kickoff_check", "properties": {"half": {"const": 1}}},
            {"$ref": "#/$defs/kickoff_check", "properties": {"half": {"const": 2}}}
          ],
          "minItems": 2,
          "items": false
        },
        "sources": {
          "type": "array",
          "prefixItems": [
            {"$ref": "#/$defs/source", "properties": {"name": {"const": "statsbomb_events"}}},
            {"$ref": "#/$defs/source", "properties": {"name": {"const": "statsbomb_lineups"}}},
            {"$ref": "#/$defs/source", "properties": {"name": {"const": "soccernet_labels_v2"}}}
          ],
          "minItems": 3,
          "items": false
        },
        "statsbomb_loader": {"type": "string", "minLength": 1},
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n_pairs",
            "n_ok",
            "n_needs_review",
            "n_unmatched_labels",
            "n_unmatched_statsbomb_shots",
            "n_excluded_labels"
          ],
          "properties": {
            "n_pairs": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"},
            "n_ok": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"},
            "n_needs_review": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"},
            "n_unmatched_labels": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"},
            "n_unmatched_statsbomb_shots": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"},
            "n_excluded_labels": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"}
          }
        },
        "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "expectations": {"$ref": "#/$defs/expectations"}
      }
    },
    "fetch_record": {
      "description": "Sidecar <file>.fetch.json written by `python -m gbf fetch` after the download matched its pin. path is the file's path inside the source repository; local_relpath is relative to the download root (DATA_ROOT/raw by default).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "pin",
        "role",
        "host",
        "repository",
        "revision",
        "path",
        "url",
        "local_relpath",
        "bytes",
        "git_blob_sha1",
        "sha256",
        "fetched_at",
        "restrictions",
        "terms"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "pin": {"type": "string", "minLength": 1},
        "role": {
          "enum": [
            "statsbomb_events",
            "statsbomb_lineups",
            "soccernet_labels_v2",
            "soccernet_labels_cameras"
          ]
        },
        "host": {"enum": ["github", "hf-dataset"]},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"$ref": "urn:gbf:schema:common#/$defs/git_sha1"},
        "path": {"$ref": "urn:gbf:schema:common#/$defs/relpath"},
        "url": {"type": "string", "pattern": "^https://"},
        "local_relpath": {"$ref": "urn:gbf:schema:common#/$defs/relpath"},
        "bytes": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"},
        "git_blob_sha1": {"$ref": "urn:gbf:schema:common#/$defs/git_sha1"},
        "sha256": {"$ref": "urn:gbf:schema:common#/$defs/sha256"},
        "fetched_at": {"type": "string", "format": "date-time"},
        "restrictions": {"$ref": "urn:gbf:schema:restrictions#/$defs/restrictions"},
        "terms": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "agreement_url", "accepted"],
              "properties": {
                "key": {"type": "string", "minLength": 1},
                "agreement_url": {"type": "string", "pattern": "^https://"},
                "accepted": {"const": true}
              }
            }
          ]
        }
      }
    }
  }
}
