{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gbf:schema:receipt",
  "title": "Receipt",
  "description": "Envelope for every receipt the project writes. Receipts are produced by scripts, never by hand. Each receipt states what it certifies (scope) and what it does not (limitations). Paths are relative to the repository root or to DATA_ROOT; absolute paths are rejected.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "status",
    "created_at",
    "producer",
    "code",
    "inputs",
    "scope",
    "limitations",
    "restrictions",
    "result"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "kind": {
      "enum": ["generation", "delivery", "content", "eval", "run", "plugin", "l0", "align", "gate"]
    },
    "status": {"enum": ["passed", "failed", "partial", "not_run"]},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {
      "description": "Module or script that wrote the receipt, e.g. gbf.synth.l0.",
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "object",
      "required": ["gbf_version", "git_commit", "git_dirty"],
      "additionalProperties": false,
      "properties": {
        "gbf_version": {"type": "string", "minLength": 1},
        "git_commit": {
          "anyOf": [{"$ref": "urn:gbf:schema:common#/$defs/git_sha1"}, {"const": "unknown"}]
        },
        "git_dirty": {"type": "boolean"}
      }
    },
    "inputs": {"$ref": "#/$defs/file_refs"},
    "outputs": {"$ref": "#/$defs/file_refs"},
    "seeds": {"type": "array", "items": {"type": "integer"}},
    "scope": {
      "description": "What this receipt certifies.",
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "description": "What this receipt does not certify. At least one entry.",
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "restrictions": {"$ref": "urn:gbf:schema:restrictions#/$defs/restrictions"},
    "reviewer_type": {"enum": ["human", "automated"]},
    "environment": {
      "description": "Tool and library versions, e.g. {\"ffmpeg\": \"8.1.1\", \"numpy\": \"2.5.4\"}.",
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "result": {
      "description": "Kind-specific payload. Numbers here are the only numbers a report or README may quote.",
      "type": "object"
    }
  },
  "$defs": {
    "file_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sha256"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "relpath": {"$ref": "urn:gbf:schema:common#/$defs/relpath"},
          "sha256": {"$ref": "urn:gbf:schema:common#/$defs/sha256"},
          "git_blob_sha1": {"$ref": "urn:gbf:schema:common#/$defs/git_sha1"},
          "source_revision": {"type": "string", "minLength": 1},
          "bytes": {"$ref": "urn:gbf:schema:common#/$defs/nonneg_int"}
        }
      }
    }
  }
}
